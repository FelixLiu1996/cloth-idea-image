# 复制为 .env.local 后填写。不要把真实 Key 提交到 Git。
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_COMPATIBLE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro-2026-06-22
DASHSCOPE_WAN_MODEL=wan2.7-image-pro
DASHSCOPE_VISION_MODEL=qwen3.7-plus

# Local application server
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
CLIENT_ORIGIN=http://127.0.0.1:10086
ASSET_DIRECTORY=var/assets
MODEL_PROVIDER=alibaba-qwen-image
# 万相回退：MODEL_PROVIDER=alibaba-wan，同时将 DASHSCOPE_IMAGE_MODEL 改为 wan2.7-image-pro

# Optional single-process controlled trial safeguards.
# Leave TRIAL_ACCESS_CODE empty for personal local use; set a strong code before sharing a URL.
TRIAL_ACCESS_CODE=
TRIAL_DAILY_ANALYSIS_LIMIT=20
TRIAL_DAILY_GENERATION_LIMIT=30
TRIAL_MAX_CONCURRENT_MODEL_REQUESTS=1
# Qwen Image 当前测试账号按约 2 RPM 保守排队；切换模型后可按厂商限流调整。
TRIAL_GENERATION_MIN_INTERVAL_MS=31000
# 0 disables deletion. For a shared trial, set an explicit retention period such as 720 hours.
ASSET_RETENTION_HOURS=0

# Taro build-time variable. Set this in the shell for remote test environments.
TARO_APP_API_BASE_URL=http://127.0.0.1:3000
